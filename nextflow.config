manifest {
    name='DrugPerturb'
    description='One isolated snapshot process; synthetic test or explicitly gated real replay'
    mainScript='main.nf'
    nextflowVersion='25.10.2'
}
params {
    project_root=null
    mode='core'
    python=null
    input_manifest=null
    allow_real_execution=false
    resource_metrics=true
    source_commit='UNCOMMITTED_SOURCE_CONTENT_HASHED'
    rscript='Rscript'
    execution_site='local_host'
    container_image=null
    outdir="${launchDir}/work/workflow-results"
    cpus=2
    memory='8 GB'
    time_limit='1h'
}
process { executor='local'; errorStrategy='terminate'; maxRetries=0 }
trace { enabled=params.resource_metrics; file="${params.outdir}/trace.tsv"; overwrite=false }
report { enabled=params.resource_metrics; file="${params.outdir}/execution_report.html"; overwrite=false }
timeline { enabled=params.resource_metrics; file="${params.outdir}/timeline.html"; overwrite=false }
dag { enabled=true; file="${params.outdir}/dag.dot"; overwrite=false }
profiles {
    local { includeConfig 'conf/local.config' }
    test { includeConfig 'conf/local.config'; includeConfig 'conf/test.config' }
    docker { includeConfig 'conf/docker.config' }
    ec2 { includeConfig 'conf/ec2.config' }
}
